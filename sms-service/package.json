{
  "name": "expendicure-sms-service",
  "version": "1.0.0",
  "description": "Secure SMS webhook microservice for Expendicure — parses Indian bank SMS messages and stores transactions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch"
  },
  "keywords": ["sms", "webhook", "expense-tracker", "bank", "india"],
  "author": "Expendicure",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["utils/**/*.js", "services/**/*.js", "controllers/**/*.js"]
  }
}
