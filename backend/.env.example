# =============================================================================
# EXPENDICURE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your local or cloud environment.
# DO NOT COMMIT THE REAL .env FILE OR PASSWORDS TO VERSION CONTROL.
# =============================================================================

# ─── DATABASE CONFIGURATION ──────────────────────────────────────────────────
# Standard MySQL connection settings (Local or Managed Cloud MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expendicure
DB_USER=root
DB_PASSWORD=your_secure_password_here

# ─── CLOUD MANAGED DATABASE (Optional URI Format) ───────────────────────────
# If using a cloud provider like Railway, Render, Heroku that provides a URL:
# DATABASE_URL=mysql://dbuser:dbpass@your-cloud-db-host:3306/expendicure

# ─── CLOUD SSL SETTINGS (Optional) ──────────────────────────────────────────
# Set path to CA certificate if required by cloud provider (e.g. AWS RDS / Aiven):
# DB_SSL_CA=/path/to/ca-certificate.pem
# Or disable SSL enforcement if needed:
# DB_SSL_DISABLED=false

# ─── BACKWARD COMPATIBILITY ALIASES (Optional) ──────────────────────────────
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=expendicure
# MYSQL_USER=root
# MYSQL_PASSWORD=your_secure_password_here

# ─── APPLICATION SECURITY & FLASK ────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_DEBUG=True
